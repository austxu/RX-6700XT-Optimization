+#include "dot_product_funcs.glsl"
+#include "types.glsl"
+
+// Exact Llama 2 7B decode path:
+// N=1, KV=256, 32 heads, HSK=HSV=128, F32 Q, F16 K/V/mask,
+// split-k=2, Bc=64, D_split=8, wave32, workgroup=128. Decode positions
+// 0..127 make the second physical split entirely -inf. Detect and omit that
+// split, while retaining a correctness fallback for arbitrary finite masks,
+// then reproduce the split-2 reducer and fused Q8_1_x4 arithmetic in-place.
+// The arithmetic and reduction order mirror flash_attn.comp followed by
+// flash_attn_split_k_reduce_q8_1_x4_navi22.comp for this exact shape.
+layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer QV4 { vec4 data_qv4[]; };
+layout(binding = 1) readonly buffer KV4 { f16vec4 data_kv4[]; };
+layout(binding = 2) readonly buffer VV4 { f16vec4 data_vv4[]; };
+layout(binding = 3) readonly buffer M { float16_t data_m[]; };
+layout(binding = 4) writeonly buffer O { float data_o[]; };
+layout(binding = 5, std430) writeonly buffer Q8Buf { block_q8_1_x4 data_q8[]; };
+
+layout(push_constant) uniform parameter {
+    uint32_t N;
+    uint32_t KV;
+
+    uint32_t ne1;
+    uint32_t ne2;
+    uint32_t ne3;
+
+    uint32_t neq2;
+    uint32_t neq3;
+    uint32_t nek2;
+    uint32_t nek3;
+    uint32_t nev2;
+    uint32_t nev3;
+    uint32_t nem1;
+    uint32_t nem2;
+    uint32_t nem3;
+
+    uint32_t nb01;
+    uint32_t nb02;
+    uint32_t nb03;
+    uint32_t nb11;
+    uint32_t nb12;
+    uint32_t nb13;
+    uint32_t nb21;
+    uint32_t nb22;
+    uint32_t nb23;
+
+    float scale;
+    float max_bias;
+    float logit_softcap;
+
+    uint32_t mask_n_head_log2;
+    float m0;
+    float m1;
+
+    uint32_t gqa_ratio;
+    uint32_t split_kv;
+    uint32_t k_num;
+} p;
+
+shared f16vec4 Qf[33];
+shared float tmpsh[32];
+shared float tmpLf[32];
+shared f16vec4 tmpshv4[4][32];
+shared uint32_t active_waves[4];
+
+void main() {
+    const uint32_t tid = gl_LocalInvocationIndex;
+    const uint32_t d_tid = tid & 7u;
+    const uint32_t col_tid = tid >> 3u;
+    const uint32_t iq2 = gl_WorkGroupID.y;
+
+    const uint32_t q_head_vec4 = iq2 * p.nb02 / 16u;
+    if (tid < 32u) {
+        Qf[tid] = f16vec4(data_qv4[q_head_vec4 + tid] * p.scale);
+    }
+    barrier();
+
+    const uint32_t k_head_vec4 = iq2 * p.nb12 / 8u;
+    const uint32_t v_head_vec4 = iq2 * p.nb22 / 8u;
+    const uint32_t k_stride_vec4 = p.nb11 / 4u;
+    const uint32_t v_stride_vec4 = p.nb21 / 4u;
+
+    const float NEG_FLT_MAX_OVER_2 = uintBitsToFloat(0xFEFFFFFF);
+    const float FATTN_KQ_MAX_OFFSET = 3.0f * 0.6931f;
+    f16vec4 split_Of[2][4];
+    float split_Lf[2];
+    float split_Mf[2];
+
+    [[unroll]] for (uint32_t split = 0u; split < 2u; ++split) {
+        bool split_active = true;
+        if (split == 1u) {
+            const bool lane_active = float(data_m[128u + tid]) > NEG_FLT_MAX_OVER_2;
+            const bool wave_active = subgroupAny(lane_active);
+            if (gl_SubgroupInvocationID == 0u) {
+                active_waves[gl_SubgroupID] = wave_active ? 1u : 0u;
+            }
+            barrier();
+            split_active = active_waves[0] != 0u || active_waves[1] != 0u ||
+                           active_waves[2] != 0u || active_waves[3] != 0u;
+        }
+
+        f16vec4 Of[4];
+        [[unroll]] for (uint32_t d = 0; d < 4u; ++d) {
+            Of[d] = f16vec4(0.0);
+        }
+        float Lf = 0.0;
+        float Mf = NEG_FLT_MAX_OVER_2;
+
+        if (split_active) {
+    [[unroll]] for (uint32_t j = split * 2u; j < split * 2u + 2u; ++j) {
+        float16_t direct_mask[4];
+        [[unroll]] for (uint32_t c = 0; c < 4u; ++c) {
+            direct_mask[c] = data_m[j * 64u + c * 16u + col_tid];
+        }
+
+        float Sf[4];
+        [[unroll]] for (uint32_t c = 0; c < 4u; ++c) {
+            Sf[c] = 0.0;
+        }
+
+        [[unroll]] for (uint32_t c = 0; c < 4u; ++c) {
+            if (float(direct_mask[c]) <= NEG_FLT_MAX_OVER_2) {
+                continue;
+            }
+            const uint32_t key = j * 64u + c * 16u + col_tid;
+            [[unroll]] for (uint32_t d = 0; d < 4u; ++d) {
+                const f16vec4 K_Tf = data_kv4[k_head_vec4 + key * k_stride_vec4 + d * 8u + d_tid];
+                Sf[c] = dot_product(Qf[d * 8u + d_tid], K_Tf, Sf[c]);
+            }
+        }
+
+        [[unroll]] for (uint32_t c = 0; c < 4u; ++c) {
+            [[unroll]] for (uint32_t s = 4u; s > 0u; s >>= 1u) {
+                Sf[c] += subgroupShuffleXor(Sf[c], s);
+            }
+            Sf[c] += float(direct_mask[c]);
+        }
+
+        float rowmaxf = NEG_FLT_MAX_OVER_2;
+        [[unroll]] for (uint32_t c = 0; c < 4u; ++c) {
+            rowmaxf = max(rowmaxf, Sf[c]);
+        }
+        rowmaxf += FATTN_KQ_MAX_OFFSET;
+
+        const float Moldf = Mf;
+        Mf = max(rowmaxf, Moldf);
+        const float eMf = exp(Moldf - Mf);
+        Lf = eMf * Lf;
+
+        [[unroll]] for (uint32_t d = 0; d < 4u; ++d) {
+            Of[d] = float16_t(eMf) * Of[d];
+        }
+
+        [[unroll]] for (uint32_t c = 0; c < 4u; ++c) {
+            if (float(direct_mask[c]) <= NEG_FLT_MAX_OVER_2) {
+                continue;
+            }
+            const float16_t Pf = float16_t(exp(Sf[c] - Mf));
+            Lf += Pf;
+            const uint32_t key = j * 64u + c * 16u + col_tid;
+            [[unroll]] for (uint32_t d = 0; d < 4u; ++d) {
+                const f16vec4 Vf = data_vv4[v_head_vec4 + key * v_stride_vec4 + d * 8u + d_tid];
+                Of[d] += f16vec4(Pf * Vf);
+            }
+        }
+    }
+
+    // Preserve the generic scalar path's wave32-then-workgroup reduction tree.
+    float rowmaxf = Mf;
+    [[unroll]] for (uint32_t s = 8u; s < 32u; s *= 2u) {
+        rowmaxf = max(rowmaxf, subgroupShuffleXor(rowmaxf, s));
+    }
+    if (gl_SubgroupInvocationID == d_tid) {
+        tmpsh[gl_SubgroupID * 8u + d_tid] = rowmaxf;
+    }
+    barrier();
+    rowmaxf = tmpsh[d_tid];
+    [[unroll]] for (uint32_t s = 1u; s < 4u; ++s) {
+        rowmaxf = max(rowmaxf, tmpsh[s * 8u + d_tid]);
+    }
+
+    const float Moldf = Mf;
+    Mf = max(rowmaxf, Moldf);
+    const float eMf = exp(Moldf - Mf);
+    Lf = eMf * Lf;
+
+    [[unroll]] for (uint32_t s = 8u; s < 32u; s *= 2u) {
+        Lf += subgroupShuffleXor(Lf, s);
+    }
+
+    [[unroll]] for (uint32_t d = 0; d < 4u; ++d) {
+        Of[d] = float16_t(eMf) * Of[d];
+        [[unroll]] for (uint32_t s = 8u; s < 32u; s *= 2u) {
+            Of[d] += subgroupShuffleXor(Of[d], s);
+        }
+    }
+
+    // L and the four independent O vectors have identical cross-wave
+    // reduction geometry.  Publish all five wave partials to scratch that is
+    // disjoint from the max and split-activity scratch.  The distinct regions
+    // eliminate reuse-only barriers while the one producer/consumer barrier
+    // and every per-value addition remain unchanged.
+    if (gl_SubgroupInvocationID == d_tid) {
+        const uint32_t partial = gl_SubgroupID * 8u + d_tid;
+        tmpLf[partial] = Lf;
+        [[unroll]] for (uint32_t d = 0; d < 4u; ++d) {
+            tmpshv4[d][partial] = Of[d];
+        }
+    }
+    barrier();
+
+    Lf = tmpLf[d_tid];
+    [[unroll]] for (uint32_t s = 1u; s < 4u; ++s) {
+        Lf += tmpLf[s * 8u + d_tid];
+    }
+
+    [[unroll]] for (uint32_t d = 0; d < 4u; ++d) {
+        Of[d] = tmpshv4[d][d_tid];
+        [[unroll]] for (uint32_t s = 1u; s < 4u; ++s) {
+            Of[d] += tmpshv4[d][s * 8u + d_tid];
+        }
+    }
+
+        }
+        [[unroll]] for (uint32_t d = 0; d < 4u; ++d) {
+            split_Of[split][d] = Of[d];
+        }
+        split_Lf[split] = Lf;
+        split_Mf[split] = Mf;
+    }
+
+    // Reproduce the retained split-2 reducer literally. A dynamically omitted
+    // split retains M=-FLT_MAX/2, L=0, and O=0. Every lane has the same reduced
+    // M/L values, so the output wave can compute these scalars directly and
+    // avoid a shared-memory broadcast and workgroup barrier.
+    if (tid < 32u) {
+        const float m0 = split_Mf[0];
+        const float m1 = split_Mf[1];
+        const float m_max = max(m0, m1);
+        const float e0 = exp(m0 - m_max);
+        const float e1 = exp(m1 - m_max);
+        const float L = e0 * split_Lf[0] + e1 * split_Lf[1];
+        const float inv_L = L == 0.0 ? 0.0 : 1.0 / L;
+        const uint32_t block = col_tid;
+        const uint32_t iqs = d_tid;
+        const uint32_t d_base = block * 32u + iqs * 4u;
+        const vec4 vals0 = vec4(split_Of[0][block]);
+        const vec4 vals1 = vec4(split_Of[1][block]);
+        vec4 vals;
+
+        [[unroll]] for (uint32_t j = 0u; j < 4u; ++j) {
+            float O = 0.0;
+            O += e0 * vals0[j];
+            O += e1 * vals1[j];
+            O *= inv_L;
+
+            const float FLT_MAX = uintBitsToFloat(0x7F7FFFFF);
+            O = clamp(O, -FLT_MAX, FLT_MAX);
+            data_o[iq2 * 128u + d_base + j] = O;
+            vals[j] = O;
+        }
+
+        const vec4 abs_vals = abs(vals);
+        const float thread_max = max(max(abs_vals.x, abs_vals.y), max(abs_vals.z, abs_vals.w));
+        const float amax = subgroupClusteredMax(thread_max, 8);
+        const float qd = amax / 127.0;
+        const float d_inv = qd != 0.0 ? 1.0 / qd : 0.0;
+        vals = round(vals * d_inv);
+
+        data_q8[iq2].qs[block * 8u + iqs] = pack32(i8vec4(vals));
+
+        const float thread_sum = vals.x + vals.y + vals.z + vals.w;
+        const float qsum = subgroupClusteredAdd(thread_sum, 8);
+        if (iqs == 0u) {
+            data_q8[iq2].ds[block] = f16vec2(vec2(qd, qsum * qd));
+        }
+    }
+}
