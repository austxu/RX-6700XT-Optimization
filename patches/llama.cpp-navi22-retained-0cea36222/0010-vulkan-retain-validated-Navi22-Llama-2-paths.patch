@@ -0,0 +1,67 @@
+#version 450
+
+#include "types.glsl"
+
+#extension GL_EXT_shader_16bit_storage : require
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer QSrc { float q_src[]; };
+layout(binding = 1) readonly buffer KSrc { float k_src[]; };
+layout(binding = 2) readonly buffer VSrc { float v_src[]; };
+layout(binding = 3) readonly buffer Pos { int positions[]; };
+layout(binding = 4) writeonly buffer QDst { float q_dst[]; };
+layout(binding = 5) writeonly buffer KDst { float16_t k_dst[]; };
+layout(binding = 6) writeonly buffer VDst { float16_t v_dst[]; };
+layout(binding = 7) readonly buffer KIndices { uvec2 k_indices[]; };
+layout(binding = 8) readonly buffer VIndices { uvec2 v_indices[]; };
+
+layout(push_constant) uniform parameter {
+    float theta_scale;
+    uint k_row_stride;
+    uint v_row_stride;
+    uint q_src_offset;
+    uint k_src_offset;
+    uint v_src_offset;
+    uint pos_offset;
+    uint q_dst_offset;
+    uint k_dst_offset;
+    uint v_dst_offset;
+    uint k_index_offset;
+    uint v_index_offset;
+    uint v_scalar_rows;
+} p;
+
+void main() {
+    const uint lane = gl_LocalInvocationID.x;
+    const uint head = gl_WorkGroupID.y;
+    const uint pair = head * 128 + 2 * lane;
+
+    const float theta_base = float(positions[p.pos_offset]) * pow(p.theta_scale, float(lane));
+    const float cos_theta = cos(theta_base);
+    const float sin_theta = sin(theta_base);
+
+    const float q0 = q_src[p.q_src_offset + pair + 0];
+    const float q1 = q_src[p.q_src_offset + pair + 1];
+    q_dst[p.q_dst_offset + pair + 0] = q0 * cos_theta - q1 * sin_theta;
+    q_dst[p.q_dst_offset + pair + 1] = q0 * sin_theta + q1 * cos_theta;
+
+    const uint k_row = k_indices[p.k_index_offset].x * p.k_row_stride;
+    const float k0 = k_src[p.k_src_offset + pair + 0];
+    const float k1 = k_src[p.k_src_offset + pair + 1];
+    k_dst[p.k_dst_offset + k_row + pair + 0] = float16_t(k0 * cos_theta - k1 * sin_theta);
+    k_dst[p.k_dst_offset + k_row + pair + 1] = float16_t(k0 * sin_theta + k1 * cos_theta);
+
+    if (p.v_scalar_rows == 0) {
+        const uint v_row = v_indices[p.v_index_offset].x * p.v_row_stride;
+        v_dst[p.v_dst_offset + v_row + pair + 0] = float16_t(v_src[p.v_src_offset + pair + 0]);
+        v_dst[p.v_dst_offset + v_row + pair + 1] = float16_t(v_src[p.v_src_offset + pair + 1]);
+    } else {
+        const uint v_idx0 = pair + 0;
+        const uint v_idx1 = pair + 1;
+        v_dst[p.v_dst_offset + v_indices[p.v_index_offset + v_idx0].x] =
+            float16_t(v_src[p.v_src_offset + v_idx0]);
+        v_dst[p.v_dst_offset + v_indices[p.v_index_offset + v_idx1].x] =
+            float16_t(v_src[p.v_src_offset + v_idx1]);
+    }
+}
