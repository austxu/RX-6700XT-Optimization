+static bool parse_bounded_u64_env(
+        const char * name, uint64_t min_value, uint64_t max_value, bool & is_set, uint64_t & value) {
+    const char * env = getenv(name);
+    is_set = env != nullptr;
+    value  = 0;
+    if (!is_set) {
+        return true;
+    }
+
+    bool digits_only = env[0] != '\0';
+    for (const char * p = env; *p != '\0'; ++p) {
+        digits_only = digits_only && *p >= '0' && *p <= '9';
+    }
+
+    errno = 0;
+    char * end = nullptr;
+    const unsigned long long parsed = strtoull(env, &end, 10);
+    if (!digits_only || errno == ERANGE || end == env || *end != '\0' ||
+        parsed < min_value || parsed > max_value) {
+        fprintf(stderr,
+                "llama-bench: error: %s must be an integer from %" PRIu64 " through %" PRIu64 "\n",
+                name, min_value, max_value);
+        return false;
+    }
+
+    value = parsed;
+    return true;
+}
