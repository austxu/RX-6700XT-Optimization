+    std::string vars() override {
+        return VARS_TO_STR4(kv, output_rows, chains, consumers);
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    double max_nmse_err() override {
+        return 5e-4;
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * out = nullptr;
+        for (uint32_t chain = 0; chain < chains; ++chain) {
+            ggml_tensor * q = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 128, 1, 32, 1);
+            ggml_tensor * k = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, 128, kv, 32, 1);
+            ggml_tensor * v = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, 128, kv, 32, 1);
+            ggml_tensor * mask = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, kv, 1, 1, 1);
+            ggml_format_name(q, "q_%u", chain);
+            ggml_format_name(k, "k_%u", chain);
+            ggml_format_name(v, "v_%u", chain);
+            ggml_format_name(mask, "mask_%u", chain);
+
+            ggml_tensor * fa = ggml_flash_attn_ext(ctx, q, k, v, mask, 1.0f/sqrtf(128.0f), 0.0f, 0.0f);
+            ggml_flash_attn_ext_set_prec(fa, GGML_PREC_F32);
+            ggml_format_name(fa, "fa_%u", chain);
+
+            ggml_tensor * activation = ggml_reshape_2d(ctx, fa, 4096, 1);
+            ggml_format_name(activation, "activation_%u", chain);
+
+            for (uint32_t consumer_idx = 0; consumer_idx < consumers; ++consumer_idx) {
+                ggml_tensor * weight = ggml_new_tensor_2d(ctx, GGML_TYPE_Q4_0, 4096, output_rows);
+                ggml_format_name(weight, "weight_%u_%u", chain, consumer_idx);
+
+                ggml_tensor * consumer = ggml_mul_mat(ctx, weight, activation);
+                ggml_format_name(consumer, "consumer_%u_%u", chain, consumer_idx);
+                out = out == nullptr ? consumer : ggml_add(ctx, out, consumer);
+            }
+        }
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
