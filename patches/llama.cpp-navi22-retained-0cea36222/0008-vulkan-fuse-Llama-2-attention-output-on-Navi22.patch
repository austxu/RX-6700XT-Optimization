+struct test_flash_attn_q4_0_mul_mat : public test_case {
+    const int64_t kv;
+    const int64_t output_rows;
+    const uint32_t chains;
+    const uint32_t consumers;
+
+    explicit test_flash_attn_q4_0_mul_mat(
+            int64_t kv = 256,
+            int64_t output_rows = 4096,
+            uint32_t chains = 1,
+            uint32_t consumers = 1)
+        : kv(kv), output_rows(output_rows), chains(chains), consumers(consumers) {
+        GGML_ASSERT(kv > 0 && output_rows > 0 && chains > 0 && consumers > 0);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "FLASH_ATTN_Q4_0_MUL_MAT";
+    }
