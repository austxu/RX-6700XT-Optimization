index 0000000000000000000000000000000000000000..f7fab18c32b1adb09d28abcf5578249fca539d5e
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_split_k_reduce_q8_1_x4_navi22.comp
@@ -0,0 +1,93 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_KHR_shader_subgroup_arithmetic : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_clustered : require
+
+#include "types.glsl"
+
+layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
+
+layout (binding = 0) readonly buffer A {float data_a[];};
+layout (binding = 1) readonly buffer B {float data_s[];};
+layout (binding = 2) writeonly buffer D {float data_d[];};
+layout (binding = 3, std430) writeonly buffer Q8Buf {block_q8_1_x4 data_q8[];};
+
+layout (push_constant) uniform parameter {
+    uint D;
+    uint ne1;
+    uint ne2;
+    uint ne3;
+    uint k_num;
+    uint sinks;
+} p;
+
+shared float stats[3];
+
+void main() {
+    const uint n = gl_WorkGroupID.x;
+    const uint lane = gl_LocalInvocationID.x;
+    const uint i2 = gl_WorkGroupID.z % p.ne2;
+    const uint i3 = gl_WorkGroupID.z / p.ne2;
+
+    const uint lm_base = p.D * p.ne1 * p.ne2 * p.ne3 * p.k_num;
+    const uint lm_head = p.ne1 * 2 * p.k_num * (i2 + p.ne2 * i3);
+    const uint l_offset = lm_base + lm_head + n;
+    const uint m_offset = lm_base + lm_head + p.ne1 + n;
+    const uint lm_stride = p.ne1 * 2;
+
+    if (lane == 0) {
+        const float m0 = data_a[m_offset];
+        const float m1 = data_a[m_offset + lm_stride];
+        const float m_max = max(m0, m1);
+        const float e0 = exp(m0 - m_max);
+        const float e1 = exp(m1 - m_max);
+        const float L = e0 * data_a[l_offset] + e1 * data_a[l_offset + lm_stride];
+
+        stats[0] = e0;
+        stats[1] = e1;
+        stats[2] = L == 0.0 ? 0.0 : 1.0 / L;
+    }
+    barrier();
+
+    const float e0 = stats[0];
+    const float e1 = stats[1];
+    const float inv_L = stats[2];
+    const uint block = lane / 8;
+    const uint iqs = lane % 8;
+    const uint d_base = block * 32 + iqs * 4;
+    const uint output_base = (i3 * p.ne2 + i2) * p.ne1 * p.D + p.D * n;
+    const uint o0_base = p.D * p.ne1 * p.k_num * (i2 + p.ne2 * i3) + p.D * n;
+    const uint o1_base = o0_base + p.D * p.ne1;
+
+    vec4 vals;
+    [[unroll]] for (uint j = 0; j < 4; ++j) {
+        const uint d = d_base + j;
+        float O = 0.0;
+        O += e0 * data_a[o0_base + d];
+        O += e1 * data_a[o1_base + d];
+        O *= inv_L;
+
+        const float FLT_MAX = uintBitsToFloat(0x7F7FFFFF);
+        O = clamp(O, -FLT_MAX, FLT_MAX);
+        data_d[output_base + d] = O;
+        vals[j] = O;
+    }
+
+    const vec4 abs_vals = abs(vals);
+    const float thread_max = max(max(abs_vals.x, abs_vals.y), max(abs_vals.z, abs_vals.w));
+    const float amax = subgroupClusteredMax(thread_max, 8);
+    const float qd = amax / 127.0;
+    const float d_inv = qd != 0.0 ? 1.0 / qd : 0.0;
+    vals = round(vals * d_inv);
+
+    const uint q8_outer = (i3 * p.ne2 + i2) * p.ne1 + n;
+    data_q8[q8_outer].qs[block * 8 + iqs] = pack32(i8vec4(round(vals)));
+
+    const float thread_sum = vals.x + vals.y + vals.z + vals.w;
+    const float qsum = subgroupClusteredAdd(thread_sum, 8);
+    if (iqs == 0) {
+        data_q8[q8_outer].ds[block] = f16vec2(vec2(qd, qsum * qd));
+    }
+}
