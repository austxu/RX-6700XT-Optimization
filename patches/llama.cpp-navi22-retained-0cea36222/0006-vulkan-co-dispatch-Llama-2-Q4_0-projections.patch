+static uint32_t ggml_vk_q4_0_multiproj_expected_count(const ggml_tensor * node) {
+    if (node == nullptr || node->op != GGML_OP_MUL_MAT || node->src[0] == nullptr || node->src[1] == nullptr) {
+        return 0;
+    }
+
+    const ggml_tensor * weight = node->src[0];
+    const ggml_tensor * activation = node->src[1];
+    if (weight->op != GGML_OP_NONE ||
+        weight->type != GGML_TYPE_Q4_0 || activation->type != GGML_TYPE_F32 || node->type != GGML_TYPE_F32 ||
+        weight->ne[0] != 4096 || activation->ne[0] != 4096 ||
+        weight->ne[1] != node->ne[0] ||
+        weight->ne[2] != 1 || weight->ne[3] != 1 ||
+        activation->ne[1] != 1 || activation->ne[2] != 1 || activation->ne[3] != 1 ||
+        node->ne[1] != 1 || node->ne[2] != 1 || node->ne[3] != 1 ||
+        !ggml_is_contiguous(weight) || !ggml_is_contiguous(activation) || !ggml_is_contiguous(node)) {
+        return 0;
+    }
+
+    if (node->ne[0] == 4096) {
+        return 3;
+    }
+    if (node->ne[0] == 11008) {
+        return 2;
+    }
+    return 0;
+}
+
+static bool ggml_vk_q4_0_multiproj_matches(const ggml_tensor * first, const ggml_tensor * node) {
+    const uint32_t expected = ggml_vk_q4_0_multiproj_expected_count(first);
+    return expected != 0 &&
+           ggml_vk_q4_0_multiproj_expected_count(node) == expected &&
+           node->src[1] == first->src[1] &&
+           node->src[0] != first->src[0] &&
+           memcmp(node->op_params, first->op_params, GGML_MAX_OP_PARAMS) == 0;
+}
+
+static uint32_t ggml_vk_q4_0_multiproj_eligible(
+        ggml_backend_vk_context * ctx,
+        const ggml_cgraph * cgraph,
+        int node_idx) {
+    if (!ctx->device->q4_0_multiproj_navi22 || node_idx < 0 || node_idx >= cgraph->n_nodes) {
+        return 0;
+    }
+
+    const ggml_tensor * first = cgraph->nodes[node_idx];
+    const uint32_t count = ggml_vk_q4_0_multiproj_expected_count(first);
+    if (count == 0 || node_idx + (int) count > cgraph->n_nodes) {
+        return 0;
+    }
+
+    for (uint32_t i = 0; i < count; ++i) {
+        const ggml_tensor * node = cgraph->nodes[node_idx + i];
+        if ((i != 0 && !ggml_vk_q4_0_multiproj_matches(first, node)) ||
+            node->src[0]->buffer == nullptr || node->src[1]->buffer == nullptr || node->buffer == nullptr ||
+            get_misalign_bytes(ctx, node->src[0]) != 0 ||
+            get_misalign_bytes(ctx, node->src[1]) != 0 ||
+            get_misalign_bytes(ctx, node) != 0) {
+            return 0;
+        }
+        for (uint32_t j = 0; j < i; ++j) {
+            if (node == cgraph->nodes[node_idx + j] ||
+                node->src[0] == cgraph->nodes[node_idx + j]->src[0]) {
+                return 0;
+            }
+        }
+    }
+
+    uint32_t graph_matches = 0;
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        if (cgraph->nodes[i] == first || ggml_vk_q4_0_multiproj_matches(first, cgraph->nodes[i])) {
+            ++graph_matches;
+        }
+    }
+    if (graph_matches != count) {
+        return 0;
+    }
+
+    if (ctx->device->pipeline_q4_0_multiproj_navi22 == nullptr ||
+        !ggml_vk_should_use_mmvq(ctx->device, (uint32_t) first->ne[0], 1, 4096, GGML_TYPE_Q4_0) ||
+        ctx->device->properties.limits.maxComputeWorkGroupCount[0] < (uint32_t) CEIL_DIV(first->ne[0], 2) ||
+        ctx->device->properties.limits.maxComputeWorkGroupCount[1] < count ||
+        ctx->device->properties.limits.maxPushConstantsSize < sizeof(vk_q4_0_multiproj_push_constants)) {
+        return 0;
+    }
+
+    std::array<vk_subbuffer, 3> weights {};
+    std::array<vk_subbuffer, 3> outputs {};
+    for (uint32_t i = 0; i < count; ++i) {
+        weights[i] = ggml_vk_tensor_subbuffer(ctx, cgraph->nodes[node_idx + i]->src[0]);
+        outputs[i] = ggml_vk_tensor_subbuffer(ctx, cgraph->nodes[node_idx + i]);
+    }
+
+    const vk_buffer weight_buffer = weights[0].buffer;
+    uint64_t span_begin = weights[0].offset;
+    uint64_t span_end = weights[0].offset + weights[0].size;
+    for (uint32_t i = 0; i < count; ++i) {
+        if (weights[i].buffer != weight_buffer || weights[i].size != ggml_nbytes(cgraph->nodes[node_idx + i]->src[0])) {
+            return 0;
+        }
+        span_begin = std::min(span_begin, weights[i].offset);
+        span_end = std::max(span_end, weights[i].offset + weights[i].size);
+    }
+
+    const uint64_t block_bytes = ggml_type_size(GGML_TYPE_Q4_0);
+    if (span_end <= span_begin || span_end > weight_buffer->size ||
+        span_end - span_begin > ctx->device->properties.limits.maxStorageBufferRange) {
+        return 0;
+    }
+    for (uint32_t i = 0; i < count; ++i) {
+        const uint64_t relative = weights[i].offset - span_begin;
+        if (relative % block_bytes != 0 || relative / block_bytes > std::numeric_limits<uint32_t>::max() ||
+            outputs[i].size > ctx->device->properties.limits.maxStorageBufferRange) {
+            return 0;
+        }
+    }
+
+    const vk_subbuffer activation = ggml_vk_tensor_subbuffer(ctx, first->src[1]);
+    auto const &overlap = [](const vk_subbuffer & a, const vk_subbuffer & b) {
+        return a.buffer == b.buffer && a.offset < b.offset + b.size && b.offset < a.offset + a.size;
+    };
+    for (uint32_t i = 0; i < count; ++i) {
+        if (overlap(outputs[i], activation)) {
+            return 0;
+        }
+        for (uint32_t j = 0; j < count; ++j) {
+            if (overlap(outputs[i], weights[j]) || (i != j && overlap(outputs[i], outputs[j]))) {
+                return 0;
+            }
+        }
+    }
+
+    return count;
+}
+
+static void ggml_vk_q4_0_multiproj(
+        ggml_backend_vk_context * ctx,
+        vk_context & subctx,
+        const ggml_cgraph * cgraph,
+        int node_idx) {
+    const uint32_t count = ctx->q4_0_multiproj_count;
+    GGML_ASSERT(count == 2 || count == 3);
+    GGML_ASSERT(node_idx >= 0 && node_idx + (int) count <= cgraph->n_nodes);
+    GGML_ASSERT(ggml_vk_q4_0_multiproj_expected_count(cgraph->nodes[node_idx]) == count);
+    for (uint32_t i = 1; i < count; ++i) {
+        GGML_ASSERT(ggml_vk_q4_0_multiproj_matches(cgraph->nodes[node_idx], cgraph->nodes[node_idx + i]));
+    }
+
+    const ggml_tensor * activation = cgraph->nodes[node_idx]->src[1];
+    const uint64_t activation_ne = ggml_nelements(activation);
+    const uint64_t q8_size = ggml_vk_align_size(activation_ne, 128) *
+                             ggml_type_size(GGML_TYPE_Q8_1) /
+                             ggml_blck_size(GGML_TYPE_Q8_1);
+    GGML_ASSERT(activation_ne == 4096 && q8_size <= ctx->device->properties.limits.maxStorageBufferRange);
+
+    if (ctx->prealloc_size_y < q8_size) {
+        ctx->prealloc_size_y = q8_size;
+        ggml_vk_preallocate_buffers(ctx, subctx);
+    } else if (ctx->prealloc_y == nullptr) {
+        ggml_vk_preallocate_buffers(ctx, subctx);
+    }
+    GGML_ASSERT(ctx->prealloc_y != nullptr && ctx->prealloc_y->size >= q8_size);
+
+    vk_pipeline to_q8_1 = ggml_vk_get_quantize_pipeline(ctx, GGML_TYPE_Q8_1);
+    const vk_subbuffer activation_buf = ggml_vk_tensor_subbuffer(ctx, activation);
+    const vk_subbuffer q8_buf = {ctx->prealloc_y, 0, q8_size};
+    const bool q8_cache_hit =
+        ctx->prealloc_y_last_pipeline_used == to_q8_1.get() &&
+        ctx->prealloc_y_last_tensor_used == activation &&
+        !ctx->prealloc_y_last_decode_vector_staging;
+    if (q8_cache_hit && ctx->prealloc_y_fused_q8_write_pending) {
+        ggml_vk_sync_buffers(ctx, subctx);
+    } else if (!q8_cache_hit) {
+        if (ctx->prealloc_y_need_sync || ctx->prealloc_y_fused_q8_write_pending) {
+            ggml_vk_sync_buffers(ctx, subctx);
+        }
+        ggml_pipeline_request_descriptor_sets(ctx, to_q8_1, 1);
+        ggml_vk_quantize_q8_1(ctx, subctx, activation_buf, q8_buf, activation_ne);
+        ctx->prealloc_y_last_pipeline_used = to_q8_1.get();
+        ctx->prealloc_y_last_tensor_used = activation;
+        ctx->prealloc_y_last_decode_vector_staging = false;
+    }
+
+    std::array<vk_subbuffer, 3> weights {};
+    std::array<vk_subbuffer, 3> outputs {};
+    uint64_t span_begin = std::numeric_limits<uint64_t>::max();
+    uint64_t span_end = 0;
+    for (uint32_t i = 0; i < count; ++i) {
+        weights[i] = ggml_vk_tensor_subbuffer(ctx, cgraph->nodes[node_idx + i]->src[0]);
+        outputs[i] = ggml_vk_tensor_subbuffer(ctx, cgraph->nodes[node_idx + i]);
+        span_begin = std::min(span_begin, weights[i].offset);
+        span_end = std::max(span_end, weights[i].offset + weights[i].size);
+    }
+    const vk_subbuffer weight_span = {weights[0].buffer, span_begin, span_end - span_begin};
+    if (count == 2) {
+        outputs[2] = outputs[1];
+    }
+
+    const uint64_t block_bytes = ggml_type_size(GGML_TYPE_Q4_0);
+    const vk_q4_0_multiproj_push_constants pc = {
+        4096,
+        (uint32_t) cgraph->nodes[node_idx]->ne[0],
+        count,
+        (uint32_t) ((weights[0].offset - span_begin) / block_bytes),
+        (uint32_t) ((weights[1].offset - span_begin) / block_bytes),
+        count == 3 ? (uint32_t) ((weights[2].offset - span_begin) / block_bytes) : 0,
+    };
+
+    vk_pipeline pipeline = ctx->device->pipeline_q4_0_multiproj_navi22;
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+    ggml_vk_dispatch_pipeline(
+        ctx, subctx, pipeline,
+        {weight_span, q8_buf, outputs[0], outputs[1], outputs[2]},
+        pc, {(uint32_t) cgraph->nodes[node_idx]->ne[0], count, 1});
+
+    ctx->prealloc_y_need_sync = true;
+    ctx->q4_0_mmvq_navi22_dispatches += count;
+    ++ctx->q4_0_multiproj_groups;
+    ctx->q4_0_multiproj_logical_dispatches += count;
+    if (count == 3) {
+        ++ctx->q4_0_multiproj_qkv_groups;
+    } else {
+        ++ctx->q4_0_multiproj_ffn_groups;
+    }
+}
