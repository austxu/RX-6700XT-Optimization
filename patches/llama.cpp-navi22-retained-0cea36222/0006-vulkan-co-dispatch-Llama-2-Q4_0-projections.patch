new file mode 100644
index 0000000000000000000000000000000000000000..3dc1b37d16a2ea07d4ce4c80535ffed9397817a6
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_q4_0_multiproj_navi22.comp
@@ -0,0 +1,136 @@
+#version 450
+
+#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
+#extension GL_EXT_integer_dot_product : require
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
+
+#define MMQ
+#define B_TYPE block_q8_1_x4
+
+#include "types.glsl"
+
+layout (binding = 0) readonly buffer A { A_TYPE data_a[]; };
+layout (binding = 0) readonly buffer A_PACKED16 { A_TYPE_PACKED16 data_a_packed16[]; };
+layout (binding = 1) readonly buffer B { B_TYPE data_b[]; };
+layout (binding = 2) writeonly buffer D0 { float data_d0[]; };
+layout (binding = 3) writeonly buffer D1 { float data_d1[]; };
+layout (binding = 4) writeonly buffer D2 { float data_d2[]; };
+
+layout (push_constant) uniform parameter {
+    uint ncols;
+    uint nrows;
+    uint projection_count;
+    uint a_block_offset0;
+    uint a_block_offset1;
+    uint a_block_offset2;
+} p;
+
+layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+#define K_PER_ITER 8
+#define BLOCK_SIZE 64
+#define NUM_ROWS 2
+
+int32_t cache_b_qs[K_PER_ITER / 4];
+vec2 cache_b_ds;
+
+#include "mul_mat_vecq_funcs.glsl"
+
+uint projection_a_block_offset(const uint projection) {
+    if (projection == 0) {
+        return p.a_block_offset0;
+    }
+    if (projection == 1) {
+        return p.a_block_offset1;
+    }
+    return p.a_block_offset2;
+}
+
+void store_output(const uint projection, const uint row, const float value) {
+    if (projection == 0) {
+        data_d0[row] = value;
+    } else if (projection == 1) {
+        data_d1[row] = value;
+    } else {
+        data_d2[row] = value;
+    }
+}
+
+void iter(
+        inout float temp[NUM_ROWS],
+        const uint a_block_offset,
+        const uint first_row,
+        const uint num_rows,
+        const uint col,
+        const uint b_qs_idx) {
+    const uint b_block_idx = col / QUANT_K_Q8_1;
+    const uint b_block_idx_outer = b_block_idx / 4;
+    const uint b_block_idx_inner = b_block_idx % 4;
+    cache_b_ds = vec2(data_b[b_block_idx_outer].ds[b_block_idx_inner]);
+    cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx];
+    cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx + 4];
+
+    uint ibi = first_row * p.ncols;
+    [[unroll]] for (uint row = 0; row < num_rows; ++row) {
+        const uint a_block_idx = (ibi + col) / QUANT_K_Q8_1 + a_block_offset;
+        ibi += p.ncols;
+        temp[row] += mmvq_dot_product(a_block_idx, b_qs_idx);
+    }
+}
+
+void main() {
+    const uint projection = gl_WorkGroupID.y;
+    if (projection >= p.projection_count) {
+        return;
+    }
+
+    const uint first_row = NUM_ROWS * gl_WorkGroupID.x;
+    if (first_row >= p.nrows) {
+        return;
+    }
+    const uint num_rows = min(uint(NUM_ROWS), p.nrows - first_row);
+    const uint tid = gl_LocalInvocationID.x;
+    const uint a_block_offset = projection_a_block_offset(projection);
+
+    float temp[NUM_ROWS];
+    [[unroll]] for (uint row = 0; row < num_rows; ++row) {
+        temp[row] = 0.0f;
+    }
+
+    const uint col_stride = K_PER_ITER * BLOCK_SIZE;
+    uint num_iters = p.ncols / col_stride;
+    if (num_iters * col_stride + K_PER_ITER * tid < p.ncols) {
+        num_iters++;
+    }
+
+    const uint b_qs_idx = tid % (32 / K_PER_ITER);
+    uint col = tid * K_PER_ITER;
+    while (num_iters >= 4) {
+        [[unroll]] for (uint k = 0; k < 4; ++k) {
+            iter(temp, a_block_offset, first_row, num_rows, col, b_qs_idx);
+            col += col_stride;
+        }
+        num_iters -= 4;
+    }
+    if (num_iters >= 2) {
+        iter(temp, a_block_offset, first_row, num_rows, col, b_qs_idx);
+        col += col_stride;
+        iter(temp, a_block_offset, first_row, num_rows, col, b_qs_idx);
+        col += col_stride;
+        num_iters -= 2;
+    }
+    if (num_iters > 0) {
+        iter(temp, a_block_offset, first_row, num_rows, col, b_qs_idx);
+    }
+
+    [[unroll]] for (uint row = 0; row < num_rows; ++row) {
+        temp[row] = subgroupAdd(temp[row]);
+    }
+    if (gl_SubgroupInvocationID == 0) {
+        [[unroll]] for (uint row = 0; row < num_rows; ++row) {
+            store_output(projection, first_row + row, temp[row]);
+        }
+    }
+}
