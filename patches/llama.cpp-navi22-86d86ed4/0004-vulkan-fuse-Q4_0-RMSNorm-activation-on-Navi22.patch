+// GGML_OP_RMS_NORM + GGML_OP_MUL + GGML_OP_MUL_MAT
+struct test_rms_norm_mul_q4_0_mul_mat : public test_case {
+    const int64_t k;
+    const int64_t output_rows;
+    const int64_t n;
+    const bool add_input;
+    const uint32_t consumers;
+    const float eps;
+
+    test_rms_norm_mul_q4_0_mul_mat(
+            int64_t k,
+            int64_t output_rows,
+            int64_t n = 1,
+            bool add_input = false,
+            uint32_t consumers = 1,
+            float eps = 1e-6f)
+        : k(k), output_rows(output_rows), n(n), add_input(add_input), consumers(consumers),
+          eps(eps) {
+        GGML_ASSERT(k > 0 && k % ggml_blck_size(GGML_TYPE_Q4_0) == 0);
+        GGML_ASSERT(output_rows > 0 && n > 0);
+        GGML_ASSERT(consumers == 1 || consumers == 2);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "RMS_NORM_MUL_Q4_0_MUL_MAT";
+    }
+
+    std::string vars() override {
+        return VARS_TO_STR6(k, output_rows, n, add_input, consumers, eps);
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * input = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+        ggml_tensor * scale = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, k);
+        ggml_set_name(input, "input");
+        ggml_set_name(scale, "scale");
+
+        if (add_input) {
+            ggml_tensor * residual = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+            ggml_set_name(residual, "residual");
+            input = ggml_add(ctx, input, residual);
+            ggml_set_name(input, "input_add");
+        }
+
+        ggml_tensor * activation = ggml_mul(ctx, ggml_rms_norm(ctx, input, eps), scale);
+        ggml_set_name(activation, "activation");
+
+        ggml_tensor * out = nullptr;
+        for (uint32_t i = 0; i < consumers; ++i) {
+            ggml_tensor * weight = ggml_new_tensor_2d(ctx, GGML_TYPE_Q4_0, k, output_rows);
+            ggml_format_name(weight, "weight_%u", i);
+            ggml_tensor * consumer = ggml_mul_mat(ctx, weight, activation);
+            ggml_format_name(consumer, "consumer_%u", i);
+            out = out == nullptr ? consumer : ggml_add(ctx, out, consumer);
+        }
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    double max_nmse_err() override {
+        return 5e-4;
+    }
+};
