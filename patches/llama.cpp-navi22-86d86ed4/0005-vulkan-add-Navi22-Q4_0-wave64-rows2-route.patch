         base_work_group_y += groups_y;
     }
 
@@ -16867,6 +16929,7 @@ static ggml_status ggml_backend_vk_graph_compute(ggml_backend_t backend, ggml_cg
     ctx->rms_norm_mul_q8_1_q4_k_dispatches = 0;
     ctx->rms_norm_mul_q8_1_partial_dispatches = 0;
     ctx->rms_norm_mul_q8_1_direct_dispatches = 0;
+    ctx->q4_0_mmvq_navi22_dispatches = 0;
 
     // On weaker AMD GPUs larger submissions can hit a driver timeout, submit more often to avoid this
     if (ctx->device->vendor_id == VK_VENDOR_ID_AMD && ctx->device->shader_core_count > 0) {
@@ -17178,6 +17241,16 @@ static ggml_status ggml_backend_vk_graph_compute(ggml_backend_t backend, ggml_cg
             ctx->rms_norm_mul_q8_1_q4_k_dispatches);
     }
 
+    if (ctx->device->q4_0_mmvq_navi22 &&
+        ctx->q4_0_mmvq_navi22_dispatches != 0 &&
+        !ctx->device->q4_0_mmvq_navi22_diagnostic_logged.exchange(true)) {
