         if (rms_norm_mul_q8_1_navi22_env != nullptr) {
@@ -9528,6 +9587,9 @@ static void ggml_vk_mul_mat_vec_q_f16(ggml_backend_vk_context * ctx, vk_context&
                                     d_F1,
