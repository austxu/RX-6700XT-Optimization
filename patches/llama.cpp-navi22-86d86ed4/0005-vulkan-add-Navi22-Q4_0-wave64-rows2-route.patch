+            "ggml_vulkan: Q4_0 x Q8_1 Navi22 MMVQ coverage "
+            "(n=1 wave64 rows_per_workgroup=2 dispatches=%u)\n",
+            ctx->q4_0_mmvq_navi22_dispatches);
+    }
+
     if (vk_perf_logger_enabled) {
         // End the command buffer and submit/wait
         GGML_ASSERT(!ctx->compute_ctx.expired());
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index da93719eb476f01a5346bff32a4cf839c75449a9..7694ca3245dde0be728dc1e31a09314060bee552 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -3629,6 +3629,43 @@ struct test_rms_norm_mul_q4_0_mul_mat : public test_case {
 
     bool run_whole_graph() override { return true; }
 
+    static uint32_t tensor_seed(const ggml_tensor * t) {
+        uint32_t seed = 2166136261u;
+        for (const char * p = ggml_get_name(t); *p; ++p) {
+            seed ^= (uint8_t) *p;
+            seed *= 16777619u;
+        }
+        for (int i = 0; i < GGML_MAX_DIMS; ++i) {
+            seed ^= (uint32_t) t->ne[i];
+            seed *= 16777619u;
+        }
+        return seed;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            const size_t nels = ggml_nelements(t);
+            std::mt19937 rng(tensor_seed(t));
+            std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
+            std::vector<float> data(nels);
+            for (float & value : data) {
+                value = dist(rng);
+            }
+
+            if (t->type == GGML_TYPE_F32) {
+                ggml_backend_tensor_set(t, data.data(), 0, data.size()*sizeof(float));
+            } else if (t->type == GGML_TYPE_Q4_0) {
+                const size_t blck_size = ggml_blck_size(t->type);
+                GGML_ASSERT(nels % blck_size == 0);
+                std::vector<uint8_t> dataq(ggml_row_size(t->type, nels));
+                ggml_quantize_chunk(t->type, data.data(), dataq.data(), 0, nels/blck_size, blck_size, nullptr);
+                ggml_backend_tensor_set(t, dataq.data(), 0, dataq.size());
+            } else {
+                GGML_ABORT("unexpected tensor type in deterministic Q4_0 whole-graph test");
+            }
+        }
+    }
+
     ggml_tensor * build_graph(ggml_context * ctx) override {
         ggml_tensor * input = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
         ggml_tensor * scale = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, k);
@@ -8788,6 +8825,8 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
         test_cases.emplace_back(new test_rms_norm_mul_q4_0_mul_mat(4096, output_rows));
     }
     test_cases.emplace_back(new test_rms_norm_mul_q4_0_mul_mat(4096, 11008));
+    test_cases.emplace_back(new test_rms_norm_mul_q4_0_mul_mat(11008, 4096));
+    test_cases.emplace_back(new test_rms_norm_mul_q4_0_mul_mat(4096, 32000));
     test_cases.emplace_back(new test_rms_norm_mul_q4_0_mul_mat(14336, 33));
     test_cases.emplace_back(new test_rms_norm_mul_q4_0_mul_mat(4096, 4096, 1, true));
     test_cases.emplace_back(new test_rms_norm_mul_q4_0_mul_mat(4096, 33, 1, false, 2));
