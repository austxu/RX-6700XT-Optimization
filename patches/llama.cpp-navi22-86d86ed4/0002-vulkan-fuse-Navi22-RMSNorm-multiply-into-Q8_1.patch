+    string_to_spv("rms_norm_mul_partials_q8_1_x4_navi22", "rms_norm_mul_partials_q8_1_x4_navi22.comp", merge_maps(base_dict, {{"A_TYPE", "float"}, {"B_TYPE", "float"}, {"D_TYPE", "float"}}));
