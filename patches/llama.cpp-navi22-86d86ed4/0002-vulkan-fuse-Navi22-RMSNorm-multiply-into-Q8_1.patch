index 0000000000000000000000000000000000000000..81d54fad3f631542873298a3ec6de72827850193
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/rms_norm_mul_partials_q8_1_x4_navi22.comp
@@ -0,0 +1,126 @@
+#version 450
+
+// Decode-only experiment: finish the partials RMSNorm+MUL operation and
+// produce the Q8_1_x4 staging representation consumed by the integer-dot
+// mat-vec path in the same dispatch.
+//
+// Host contract:
+//   * A_TYPE, B_TYPE, D_TYPE, and FLOAT_TYPE are float.
+//   * specialization constant 1 (do_multiply) is true.
+//   * local size is 128 and the pipeline requests a full 32-lane subgroup.
+//   * each workgroup covers one contiguous, 128-element-aligned output chunk.
+//   * binding 4 starts at the beginning of a suitably sized/aligned Q8_1
+//     sidecar buffer (one block_q8_1_x4, 144 bytes, per workgroup).
+//
+// Binding 0/1/2/3 and the push constants intentionally retain the exact ABI
+// of rms_norm_partials.comp. Binding 4 is the only ABI addition.
+
+#include "generic_binary_head.glsl"
+#include "types.glsl"
+
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_KHR_shader_subgroup_arithmetic : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_clustered : require
+
+#define BLOCK_SIZE 128
+
+layout (constant_id = 1) const bool do_multiply = false;
+
+layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;
+
+layout (binding = 3, std430) readonly buffer PartialsBuf {float partial_sums[];};
+layout (binding = 4, std430) writeonly buffer Q8Buf {block_q8_1_x4 data_q8[];};
+
+shared FLOAT_TYPE sumsh[BLOCK_SIZE];
+shared float q8_values[BLOCK_SIZE];
+
+void main() {
+    const uint ncols     = p.ne00;
+    const uint nchunks   = gl_NumWorkGroups.x;
+    const uint nchannels = gl_NumWorkGroups.y;
+
+    const uint row       = 0;
+    const uint channel   = gl_WorkGroupID.y;
+    const uint samp      = gl_WorkGroupID.z;
+    // The work is split across multiple workgroups in the x dimension. Each
+    // invocation processes one element.
+    const uint tid       = gl_GlobalInvocationID.x;
+    const uint ltid      = gl_LocalInvocationID.x;
+
+    const uint stride_row       = p.nb01;
+    const uint stride_channel   = p.nb02;
+    const uint stride_sample    = p.nb03;
+
+    uint32_t a_offset = samp*stride_sample + channel*stride_channel + row*stride_row + get_aoffset();
+    uint32_t b_offset = src1_idx(0, row, channel, samp) + get_boffset();
+    uint32_t d_offset = ((samp*nchannels + channel)*nchunks + row)*ncols + get_doffset();
+
+    FLOAT_TYPE sum = FLOAT_TYPE(0.0f); // partial sum for thread in warp
+
+    uint32_t num_partials = p.param3;
+    for (uint32_t i = gl_SubgroupInvocationID; i < num_partials; i += gl_SubgroupSize) {
+        sum += partial_sums[i];
+    }
+    sum = subgroupAdd(sum);
+
+    // q8_values holds exactly the F32 value written to binding 2. Keeping the
+    // sidecar source in shared memory avoids a storage-buffer read-after-write
+    // and its extra buffer memory barrier.
+    float produced = 0.0f;
+    const uint col = tid;
+    if (col < ncols) {
+        const FLOAT_TYPE mean = sum / FLOAT_TYPE(ncols);
+        const FLOAT_TYPE scale = inversesqrt(mean + FLOAT_TYPE(p.param1));
+
+        if (do_multiply) {
+            if (ncols > p.ne10) {
+                produced = float(D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + col]) * FLOAT_TYPE(data_b[b_offset + fastmod(col, p.ne10)])));
+            } else {
+                produced = float(D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + col]) * FLOAT_TYPE(data_b[b_offset + col])));
+            }
+        } else {
+            produced = float(D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + col])));
+        }
+        data_d[d_offset + col] = D_TYPE(produced);
+    }
+    q8_values[ltid] = produced;
+
+    // All four waves finish the F32 producer before wave 0 consumes its 128
+    // values as 32 vec4s. Host routing is restricted to wave32/full-subgroup
+    // devices, so these lanes map exactly to quantize_q8_1.comp's subgroup
+    // QBLOCK_X4 layout: four adjacent 8-lane clusters, one Q8_1 block each.
+    barrier();
+
+    if (gl_SubgroupID != 0) {
+        return;
+    }
+
+    const uint lane = gl_SubgroupInvocationID;
+    const uint block_in_x4 = lane / 8;
+    const uint iqs = lane % 8;
+    const uint value_base = lane * 4;
+    const uint q8_outer = (samp*nchannels + channel)*nchunks + gl_WorkGroupID.x;
+
+    vec4 vals = vec4(q8_values[value_base + 0],
+                     q8_values[value_base + 1],
+                     q8_values[value_base + 2],
+                     q8_values[value_base + 3]);
+    const vec4 abs_vals = abs(vals);
+
+    // This sequence deliberately matches quantize_q8_1.comp's subgroup path,
+    // including its operation order, redundant final round, and FP16 ds store.
+    const float thread_max = max(max(abs_vals.x, abs_vals.y), max(abs_vals.z, abs_vals.w));
+    const float amax = subgroupClusteredMax(thread_max, 8);
+    const float d = amax / 127.0;
+    const float d_inv = d != 0.0 ? 1.0 / d : 0.0;
+    vals = round(vals * d_inv);
+
+    data_q8[q8_outer].qs[block_in_x4 * 8 + iqs] = pack32(i8vec4(round(vals)));
+
+    const float thread_sum = vals.x + vals.y + vals.z + vals.w;
+    const float qsum = subgroupClusteredAdd(thread_sum, 8);
+    if (iqs == 0) {
+        data_q8[q8_outer].ds[block_in_x4] = f16vec2(vec2(d, qsum * d));
+    }
+}
