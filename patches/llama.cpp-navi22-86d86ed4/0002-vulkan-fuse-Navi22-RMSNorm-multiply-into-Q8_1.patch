+static bool ggml_vk_rms_norm_mul_q8_1_navi22_eligible(
+        ggml_backend_vk_context * ctx,
+        const ggml_cgraph * cgraph,
+        int node_idx,
+        const ggml_tensor * activation) {
+    if (!ctx->device->rms_norm_mul_q8_1_navi22 ||
+        ctx->num_additional_fused_ops != 1) {
+        return false;
+    }
+    ++ctx->rms_norm_mul_q8_1_structural;
+    if (node_idx + 2 >= cgraph->n_nodes) {
+        return false;
+    }
+    if (ctx->do_add_rms_partials) {
+        ++ctx->rms_norm_mul_q8_1_partials;
+    } else {
+        ++ctx->rms_norm_mul_q8_1_direct_eligible;
+    }
+
+    // Require the first node after the fused RMSNorm+MUL pair to be the exact
+    // MMVQ consumer. This prevents speculative sidecar writes from surviving
+    // across an unrelated user of the shared prealloc_y scratch buffer.
+    const ggml_tensor * consumer = cgraph->nodes[node_idx + 2];
+    if (consumer->op != GGML_OP_MUL_MAT) {
+        return false;
+    }
+    const ggml_tensor * weight = consumer->src[0];
+    ++ctx->rms_norm_mul_q8_1_next_matmul;
+    if (consumer->src[1] != activation) {
+        return false;
+    }
+    ++ctx->rms_norm_mul_q8_1_activation_match;
+    if (
+        weight == nullptr ||
+        weight->type != GGML_TYPE_Q4_K ||
+        activation->type != GGML_TYPE_F32 ||
+        consumer->type != GGML_TYPE_F32 ||
+        consumer->ne[1] != 1 ||
+        weight->ne[0] != activation->ne[0] ||
+        weight->ne[1] != consumer->ne[0] ||
+        weight->ne[2] != 1 || weight->ne[3] != 1 ||
+        !ggml_vk_dim01_contiguous(weight) ||
+        !ggml_is_contiguous(activation)) {
+        return false;
+    }
+    ++ctx->rms_norm_mul_q8_1_q4_shape;
+
+    const int64_t k64 = activation->ne[0];
+    if ((k64 != 4096 && k64 != 14336) || (k64 % 128) != 0) {
+        return false;
+    }
+    const uint32_t k = (uint32_t) k64;
+    if (!ggml_vk_should_use_mmvq(ctx->device, (uint32_t) weight->ne[1], 1, k, weight->type)) {
+        return false;
+    }
+
+    // Match ggml_vk_mul_mat_vec_q_f16's Q8_1 route selection, including the
+    // requirement that a concrete Q8_1 matvec pipeline exists for this shape.
+    const bool route = ctx->device->integer_dot_product &&
+        ggml_vk_get_dequantize_mul_mat_vec(
+            ctx, weight->type, GGML_TYPE_Q8_1, 1,
+            (uint32_t) consumer->ne[0], k) != nullptr;
+    if (route) {
+        ++ctx->rms_norm_mul_q8_1_route;
+    }
+    return route;
+}
+
+static void ggml_vk_rms_norm_mul_q8_1_navi22(
+        ggml_backend_vk_context * ctx,
+        vk_context & subctx,
+        const ggml_tensor * src0,
+        const ggml_tensor * src1,
+        ggml_tensor * dst,
+        vk_op_binary_push_constants & pc) {
+    const size_t ne = ggml_nelements(dst);
+    const size_t q8_size = ggml_vk_align_size(ne, 128) *
+                           ggml_type_size(GGML_TYPE_Q8_1) /
+                           ggml_blck_size(GGML_TYPE_Q8_1);
+    GGML_ASSERT((ne == 4096 || ne == 14336) && ne % 128 == 0);
+    GGML_ASSERT(q8_size <= ctx->device->properties.limits.maxStorageBufferRange);
+
+    if (ctx->prealloc_size_y < q8_size) {
+        ctx->prealloc_size_y = q8_size;
+        ggml_vk_preallocate_buffers(ctx, subctx);
+    } else if (ctx->prealloc_y == nullptr) {
+        ggml_vk_preallocate_buffers(ctx, subctx);
+    }
+    GGML_ASSERT(ctx->prealloc_y != nullptr && ctx->prealloc_y->size >= q8_size);
+
+    // A previous reader or fused producer may still be using this shared
+    // scratch allocation. Make that access complete before overwriting it.
+    if (ctx->prealloc_y_need_sync || ctx->prealloc_y_fused_q8_write_pending) {
+        ggml_vk_sync_buffers(ctx, subctx);
+    }
+
+    const bool use_partials = ctx->do_add_rms_partials;
+    vk_pipeline pipeline = use_partials ?
+        ctx->device->pipeline_rms_norm_mul_partials_q8_1_x4_navi22 :
+        ctx->device->pipeline_rms_norm_mul_q8_1_x4_navi22;
+    vk_pipeline to_q8_1 = ggml_vk_get_quantize_pipeline(ctx, GGML_TYPE_Q8_1);
+    GGML_ASSERT(pipeline != nullptr && to_q8_1 != nullptr);
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    init_pushconst_fastdiv(pc);
+    const vk_subbuffer src0_buf = ggml_vk_tensor_subbuffer(ctx, src0, true);
+    const vk_subbuffer src1_buf = ggml_vk_tensor_subbuffer(ctx, src1, true);
+    const vk_subbuffer dst_buf = ggml_vk_tensor_subbuffer(ctx, dst, true);
+    const vk_subbuffer q8_buf = { ctx->prealloc_y, 0, q8_size };
+    init_pushconst_tensor_offsets(ctx, pc, src0, src1, nullptr, nullptr, dst);
+
+    if (use_partials) {
+        const vk_subbuffer partials_buf = ggml_vk_subbuffer(
+            ctx, ctx->prealloc_add_rms_partials, ctx->prealloc_size_add_rms_partials_offset);
+        ggml_vk_dispatch_pipeline(
+            ctx, subctx, pipeline,
+            { src0_buf, src1_buf, dst_buf, partials_buf, q8_buf },
+            pc, { (uint32_t) CEIL_DIV(ne, 128), 1, 1 });
+        ++ctx->rms_norm_mul_q8_1_partial_dispatches;
+    } else {
+        ggml_vk_dispatch_pipeline(
+            ctx, subctx, pipeline,
+            { src0_buf, src1_buf, dst_buf, q8_buf },
+            pc, { 1, 1, 1 });
+        ++ctx->rms_norm_mul_q8_1_direct_dispatches;
+    }
+
+    // Publish exactly the identity expected by the standalone Q8_1 cache
+    // check. The pending flag supplies the barrier normally emitted by
+    // ggml_vk_quantize_q8_1 before an MMVQ consumer reads this sidecar.
+    ctx->prealloc_y_last_pipeline_used = to_q8_1.get();
+    ctx->prealloc_y_last_tensor_used = dst;
+    ctx->prealloc_y_last_decode_vector_staging = false;
+    ctx->prealloc_y_fused_q8_write_pending = true;
+    ctx->prealloc_y_need_sync = true;
+    ++ctx->rms_norm_mul_q8_1_dispatches;
+}
