diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/rms_norm_mul_partials_q8_1_x4_navi22.comp b/ggml/src/ggml-vulkan/vulkan-shaders/rms_norm_mul_partials_q8_1_x4_navi22.comp
