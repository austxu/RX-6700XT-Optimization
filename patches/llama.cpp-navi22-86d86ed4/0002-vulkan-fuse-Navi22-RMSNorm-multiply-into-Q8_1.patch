index 0000000000000000000000000000000000000000..cc97db2088ba8ec092feb87cca58a62e329ca940
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/rms_norm_mul_q8_1_x4_navi22.comp
@@ -0,0 +1,135 @@
+#version 450
+
+// Decode-only Navi22 experiment: retain the standard 512-thread F32
+// RMSNorm+MUL reduction while producing the Q8_1_x4 activation sidecar in the
+// same dispatch. Host routing is restricted to one contiguous row with width
+// 4096 or 14336 and to full 32-lane subgroups.
+
+#include "generic_binary_head.glsl"
+#include "types.glsl"
+
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_KHR_shader_subgroup_arithmetic : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_clustered : require
+
+#define BLOCK_SIZE 512
+#define WAVES_PER_WORKGROUP 16
+
+layout (constant_id = 1) const bool do_multiply = false;
+
+layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;
+
+layout (binding = 3, std430) writeonly buffer Q8Buf {block_q8_1_x4 data_q8[];};
+
+shared FLOAT_TYPE sumsh[BLOCK_SIZE];
+
+void rms_norm_mul_q8(uint num_iters, uint q8_iters) {
+    const uint ncols     = p.ne00;
+    const uint nrows     = gl_NumWorkGroups.x;
+    const uint nchannels = gl_NumWorkGroups.y;
+
+    const uint row       = gl_WorkGroupID.x;
+    const uint channel   = gl_WorkGroupID.y;
+    const uint samp      = gl_WorkGroupID.z;
+    const uint tid       = gl_LocalInvocationID.x;
+
+    const uint stride_row       = p.nb01;
+    const uint stride_channel   = p.nb02;
+    const uint stride_sample    = p.nb03;
+
+    const uint32_t a_offset = samp*stride_sample + channel*stride_channel + row*stride_row + get_aoffset();
+    const uint32_t b_offset = src1_idx(0, row, channel, samp) + get_boffset();
+    const uint32_t d_offset = ((samp*nchannels + channel)*nrows + row)*ncols + get_doffset();
+
+    // This is the standard rms_norm.comp reduction. Width 14336 deliberately
+    // executes 32 iterations with zero-valued tail elements.
+    FLOAT_TYPE sum = FLOAT_TYPE(0.0f);
+    [[unroll]] for (uint col = tid, idx = 0; idx < num_iters; col += BLOCK_SIZE, ++idx) {
+        FLOAT_TYPE xi = FLOAT_TYPE(0);
+        if (col < ncols) {
+            xi = FLOAT_TYPE(data_a[a_offset + col]);
+        }
+        sum += xi * xi;
+    }
+
+    sumsh[tid] = sum;
+    barrier();
+    [[unroll]] for (int s = BLOCK_SIZE / 2; s > 0; s >>= 1) {
+        if (tid < s) {
+            sum += sumsh[tid + s];
+            sumsh[tid] = sum;
+        }
+        barrier();
+    }
+    sum = sumsh[0];
+
+    const FLOAT_TYPE mean = sum / FLOAT_TYPE(ncols);
+    const FLOAT_TYPE scale = inversesqrt(mean + FLOAT_TYPE(p.param1));
+
+    // Sixteen wave32s cover sixteen consecutive 128-value Q8_1_x4 chunks per
+    // iteration. Each lane owns four contiguous values, matching the
+    // standalone quantizer's byte order: two iterations at 4096, seven at
+    // 14336.
+    const uint wave = gl_SubgroupID;
+    const uint lane = gl_SubgroupInvocationID;
+    const uint block_in_x4 = lane / 8;
+    const uint iqs = lane % 8;
+    const uint q8_row_base = ((samp*nchannels + channel)*nrows + row)*(ncols / 128);
+
+    [[unroll]] for (uint q8_iter = 0; q8_iter < q8_iters; ++q8_iter) {
+        const uint chunk = wave + q8_iter*WAVES_PER_WORKGROUP;
+        const uint value_base = chunk*128 + lane*4;
+
+        vec4 vals;
+        if (do_multiply) {
+            if (ncols > p.ne10) {
+                vals.x = float(D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + value_base + 0]) * FLOAT_TYPE(data_b[b_offset + fastmod(value_base + 0, p.ne10)])));
+                vals.y = float(D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + value_base + 1]) * FLOAT_TYPE(data_b[b_offset + fastmod(value_base + 1, p.ne10)])));
+                vals.z = float(D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + value_base + 2]) * FLOAT_TYPE(data_b[b_offset + fastmod(value_base + 2, p.ne10)])));
+                vals.w = float(D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + value_base + 3]) * FLOAT_TYPE(data_b[b_offset + fastmod(value_base + 3, p.ne10)])));
+            } else {
+                vals.x = float(D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + value_base + 0]) * FLOAT_TYPE(data_b[b_offset + value_base + 0])));
+                vals.y = float(D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + value_base + 1]) * FLOAT_TYPE(data_b[b_offset + value_base + 1])));
+                vals.z = float(D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + value_base + 2]) * FLOAT_TYPE(data_b[b_offset + value_base + 2])));
+                vals.w = float(D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + value_base + 3]) * FLOAT_TYPE(data_b[b_offset + value_base + 3])));
+            }
+        } else {
+            vals.x = float(D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + value_base + 0])));
+            vals.y = float(D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + value_base + 1])));
+            vals.z = float(D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + value_base + 2])));
+            vals.w = float(D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + value_base + 3])));
+        }
+
+        data_d[d_offset + value_base + 0] = D_TYPE(vals.x);
+        data_d[d_offset + value_base + 1] = D_TYPE(vals.y);
+        data_d[d_offset + value_base + 2] = D_TYPE(vals.z);
+        data_d[d_offset + value_base + 3] = D_TYPE(vals.w);
+
+        // Match quantize_q8_1.comp and the proven partial fused shader exactly,
+        // including the redundant final round and FP16 ds conversion.
+        const vec4 abs_vals = abs(vals);
+        const float thread_max = max(max(abs_vals.x, abs_vals.y), max(abs_vals.z, abs_vals.w));
+        const float amax = subgroupClusteredMax(thread_max, 8);
+        const float d = amax / 127.0;
+        const float d_inv = d != 0.0 ? 1.0 / d : 0.0;
+        vals = round(vals * d_inv);
+
+        const uint q8_outer = q8_row_base + chunk;
+        data_q8[q8_outer].qs[block_in_x4 * 8 + iqs] = pack32(i8vec4(round(vals)));
+
+        const float thread_sum = vals.x + vals.y + vals.z + vals.w;
+        const float qsum = subgroupClusteredAdd(thread_sum, 8);
+        if (iqs == 0) {
+            data_q8[q8_outer].ds[block_in_x4] = f16vec2(vec2(d, qsum * d));
+        }
+    }
+}
+
+void main() {
+    if (p.ne00 == 4096) {
+        rms_norm_mul_q8(8, 2);
+    } else if (p.ne00 == 14336) {
+        rms_norm_mul_q8(32, 7);
+    }
+}
