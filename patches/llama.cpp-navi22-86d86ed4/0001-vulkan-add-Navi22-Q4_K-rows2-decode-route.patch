From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: austxu <austxu@users.noreply.github.com>
Date: Thu, 16 Jul 2026 13:42:30 -0700
Subject: [PATCH 1/9] vulkan: add Navi22 Q4_K rows2 decode route

Assisted-by: OpenAI Codex
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp | 59 +++++++++++++++++++++++++++-
 1 file changed, 58 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index c3fd436a101193f2faad5272f25ca28db32a7c79..b113e13d08ca05c7eb791430ab302b75de0f0593 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -329,6 +329,7 @@ static void ggml_vk_synchronize(ggml_backend_vk_context * ctx);
 
 static constexpr uint32_t mul_mat_vec_max_cols = 8;
 static constexpr uint32_t p021_max_gqa_ratio = 8;
+static constexpr uint32_t navi22_rx_6700_xt_device_id = 0x73df;
 
 enum vk_device_architecture {
     OTHER,
@@ -744,6 +745,8 @@ struct vk_device_struct {
     bool integer_dot_product;
     // 0: default, 1: force mmvq, -1: disable mmvq
     int32_t mmvq_mode;
+    bool q4_k_mmvq_navi22 {};
+    std::atomic<bool> q4_k_mmvq_navi22_banner_logged {};
 
     bool subgroup_size_control;
     uint32_t subgroup_min_size;
@@ -5005,7 +5008,11 @@ static void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
 
                 ggml_vk_create_pipeline(device, device->pipeline_dequant_mul_mat_vec_q8_1_f32[w][GGML_TYPE_Q2_K][i], "mul_mat_vec_q2_k_q8_1_f32", arr_dmmv_q2_k_q8_1_f32_len[reduc], arr_dmmv_q2_k_q8_1_f32_data[reduc], "main", mul_mat_vec_num_bindings, sizeof(vk_mat_vec_push_constants), {2*rm_kq_int, 1, 1}, {wg_size_subgroup_int, 2*rm_kq_int, i+1}, 1, true, use_subgroups, subgroup_size_int);
                 ggml_vk_create_pipeline(device, device->pipeline_dequant_mul_mat_vec_q8_1_f32[w][GGML_TYPE_Q3_K][i], "mul_mat_vec_q3_k_q8_1_f32", arr_dmmv_q3_k_q8_1_f32_len[reduc], arr_dmmv_q3_k_q8_1_f32_data[reduc], "main", mul_mat_vec_num_bindings, sizeof(vk_mat_vec_push_constants), {1*rm_kq_int, 1, 1}, {wg_size_subgroup_int, 1*rm_kq_int, i+1}, 1, true, use_subgroups, subgroup_size_int);
-                ggml_vk_create_pipeline(device, device->pipeline_dequant_mul_mat_vec_q8_1_f32[w][GGML_TYPE_Q4_K][i], "mul_mat_vec_q4_k_q8_1_f32", arr_dmmv_q4_k_q8_1_f32_len[reduc], arr_dmmv_q4_k_q8_1_f32_data[reduc], "main", mul_mat_vec_num_bindings, sizeof(vk_mat_vec_push_constants), {1*rm_kq_int, 1, 1}, {wg_size_subgroup_int, 1*rm_kq_int, i+1}, 1, true, use_subgroups, subgroup_size_int);
+                if (device->q4_k_mmvq_navi22 && w == DMMV_WG_SIZE_SUBGROUP && i == 0) {
+                    ggml_vk_create_pipeline(device, device->pipeline_dequant_mul_mat_vec_q8_1_f32[w][GGML_TYPE_Q4_K][i], "mul_mat_vec_q4_k_q8_1_f32_navi22_rows2", arr_dmmv_q4_k_q8_1_f32_len[reduc], arr_dmmv_q4_k_q8_1_f32_data[reduc], "main", mul_mat_vec_num_bindings, sizeof(vk_mat_vec_push_constants), {2, 1, 1}, {32, 2, 1}, 1, true, true, 32);
+                } else {
+                    ggml_vk_create_pipeline(device, device->pipeline_dequant_mul_mat_vec_q8_1_f32[w][GGML_TYPE_Q4_K][i], "mul_mat_vec_q4_k_q8_1_f32", arr_dmmv_q4_k_q8_1_f32_len[reduc], arr_dmmv_q4_k_q8_1_f32_data[reduc], "main", mul_mat_vec_num_bindings, sizeof(vk_mat_vec_push_constants), {1*rm_kq_int, 1, 1}, {wg_size_subgroup_int, 1*rm_kq_int, i+1}, 1, true, use_subgroups, subgroup_size_int);
+                }
                 ggml_vk_create_pipeline(device, device->pipeline_dequant_mul_mat_vec_q8_1_f32[w][GGML_TYPE_Q5_K][i], "mul_mat_vec_q5_k_q8_1_f32", arr_dmmv_q5_k_q8_1_f32_len[reduc], arr_dmmv_q5_k_q8_1_f32_data[reduc], "main", mul_mat_vec_num_bindings, sizeof(vk_mat_vec_push_constants), {1*rm_kq_int, 1, 1}, {wg_size_subgroup_int, 1*rm_kq_int, i+1}, 1, true, use_subgroups, subgroup_size_int);
                 ggml_vk_create_pipeline(device, device->pipeline_dequant_mul_mat_vec_q8_1_f32[w][GGML_TYPE_Q6_K][i], "mul_mat_vec_q6_k_q8_1_f32", arr_dmmv_q6_k_q8_1_f32_len[reduc], arr_dmmv_q6_k_q8_1_f32_data[reduc], "main", mul_mat_vec_num_bindings, sizeof(vk_mat_vec_push_constants), {1*rm_kq_int, 1, 1}, {wg_size_subgroup_int, 1*rm_kq_int, i+1}, 1, true, use_subgroups, subgroup_size_int);
 
@@ -5827,6 +5834,10 @@ static void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
                                      task.entrypoint, task.parameter_count, task.wg_denoms,
                                      task.specialization_constants, task.disable_robustness,
                                      task.require_full_subgroups, task.required_subgroup_size);
+        if (task.pipeline->name == "mul_mat_vec_q4_k_q8_1_f32_navi22_rows2" &&
+            !device->q4_k_mmvq_navi22_banner_logged.exchange(true)) {
+            fprintf(stderr, "ggml_vulkan: selected Q4_K x Q8_1 Navi22 MMVQ route (n=1, wave32, 2 rows/workgroup)\n");
+        }
     }
 
     // Another thread may be compiling the pipeline we need; block on it here.
@@ -6594,6 +6605,52 @@ static vk_device ggml_vk_get_device(size_t idx) {
         // Queues
         ggml_vk_create_queue(device, device->compute_queue, compute_queue_family_index, 0, { vk::PipelineStageFlagBits::eComputeShader | vk::PipelineStageFlagBits::eTransfer }, false);
 
+        const char * q4_k_mmvq_navi22_env = getenv("GGML_VK_Q4_K_MMVQ_NAVI22");
+        if (getenv("GGML_VK_Q4_K_MMVQ_NAVI22_MODE") != nullptr ||
+            getenv("GGML_VK_Q4_K_MMVQ_NAVI22_ROWS") != nullptr) {
+            GGML_LOG_ERROR("ggml_vulkan: legacy Q4_K Navi22 MMVQ mode/rows selectors are unsupported\n");
+            throw std::runtime_error("legacy Q4_K Navi22 MMVQ mode/rows selectors are unsupported");
+        }
+        if (q4_k_mmvq_navi22_env != nullptr) {
+            const char * rejection_reason = nullptr;
+            if (strcmp(q4_k_mmvq_navi22_env, "1") != 0) {
+                rejection_reason = "the environment value must be exactly 1";
+            } else if (getenv("GGML_VK_FORCE_MMVQ") != nullptr ||
+                       getenv("GGML_VK_DISABLE_MMVQ") != nullptr) {
+                rejection_reason = "GGML_VK_FORCE_MMVQ and GGML_VK_DISABLE_MMVQ must be unset";
+            } else if (device->vendor_id != VK_VENDOR_ID_AMD ||
+                       device->properties.deviceID != navi22_rx_6700_xt_device_id) {
+                rejection_reason = "the selected device is not an AMD Radeon RX 6700 XT (device ID 0x73df)";
+            } else if (device->architecture != vk_device_architecture::AMD_RDNA2) {
+                rejection_reason = "the selected device was not detected as RDNA2";
+            } else if (device->driver_id != vk::DriverId::eMesaRadv) {
+                rejection_reason = "the selected Vulkan driver is not Mesa RADV";
+            } else if (!device->integer_dot_product) {
+                rejection_reason = "accelerated signed packed 4x8-bit integer dot product is unavailable";
+            } else if (!device->subgroup_basic || !device->subgroup_arithmetic) {
+                rejection_reason = "compute-stage subgroup basic/arithmetic operations are unavailable";
+            } else if (!device->subgroup_size_control ||
+                       device->subgroup_min_size > 32 ||
+                       device->subgroup_max_size < 32) {
+                rejection_reason = "a required subgroup size of 32 is unavailable";
+            } else if (!device->subgroup_require_full_support) {
+                rejection_reason = "full compute subgroups are unavailable";
+            } else if (device->properties.limits.maxComputeWorkGroupInvocations < 32 ||
+                       device->properties.limits.maxComputeWorkGroupSize[0] < 32) {
+                rejection_reason = "a 32-invocation compute workgroup is unavailable";
+#if !defined(GGML_VULKAN_INTEGER_DOT_GLSLC_SUPPORT)
+            } else {
+                rejection_reason = "this build does not contain integer-dot-product Vulkan shaders";
+#endif
+            }
+
+            if (rejection_reason != nullptr) {
+                GGML_LOG_ERROR("ggml_vulkan: GGML_VK_Q4_K_MMVQ_NAVI22 rejected: %s\n", rejection_reason);
+                throw std::runtime_error(std::string("GGML_VK_Q4_K_MMVQ_NAVI22 rejected: ") + rejection_reason);
+            }
+            device->q4_k_mmvq_navi22 = true;
+        }
+
         // Shaders
         // Disable matmul tile sizes early if performance low or not supported
         for (uint32_t i = 0; i < GGML_TYPE_COUNT; ++i) {
